<?xml version="1.0"?>
<robot name="ackermann_robot">

  <!-- ============================================== -->
  <!--               CYBER MATERIALS                  -->
  <!-- ============================================== -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  
  <material name="light_grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <material name="cyan">
    <color rgba="0 1 1 1"/>
  </material>
  
  <material name="flat_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="headlight_white">
    <color rgba="0.9 0.9 1.0 1"/>
  </material>

  <material name="taillight_red">
    <color rgba="1 0 0 1"/>
  </material>

  <!-- ============================================== -->
  <!--                 CHASSIS                        -->
  <!-- ============================================== -->
  <link name="base_link">
    <!-- Main Body -->
    <visual>
      <geometry>
        <box size="0.8 1.16 0.25"/> <!-- Length 0.8m (shorter than wheelbase overhang), Width 1.16m (track width) -->
      </geometry>
      <material name="dark_grey"/>
      <origin xyz="0 0 0.15"/>
    </visual>
    
    <!-- Top Deck / Plate -->
    <visual>
      <geometry>
        <box size="0.6 1.0 0.02"/>
      </geometry>
      <material name="light_grey"/>
      <origin xyz="0 0 0.28"/>
    </visual>

    <!-- Headlights (Front Left/Right) -->
    <visual>
      <geometry>
        <box size="0.02 0.1 0.05"/>
      </geometry>
      <material name="headlight_white"/>
      <origin xyz="0.4 0.5 0.2"/>
    </visual>
    <visual>
      <geometry>
        <box size="0.02 0.1 0.05"/>
      </geometry>
      <material name="headlight_white"/>
      <origin xyz="0.4 -0.5 0.2"/>
    </visual>

    <!-- Taillights (Rear Left/Right) -->
    <visual>
      <geometry>
        <box size="0.02 0.1 0.05"/>
      </geometry>
      <material name="taillight_red"/>
      <origin xyz="-0.4 0.5 0.2"/>
    </visual>
    <visual>
      <geometry>
        <box size="0.02 0.1 0.05"/>
      </geometry>
      <material name="taillight_red"/>
      <origin xyz="-0.4 -0.5 0.2"/>
    </visual>

    <!-- Roll Bar (Sporty look) -->
    <visual>
      <geometry>
        <cylinder length="1.0" radius="0.02"/> <!-- Crossbar -->
      </geometry>
      <material name="cyan"/>
      <origin xyz="-0.15 0 0.45" rpy="1.5707 0 0"/>
    </visual>
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.02"/> <!-- Left Post -->
      </geometry>
      <material name="cyan"/>
      <origin xyz="-0.15 0.5 0.35" rpy="0 0 0"/>
    </visual>
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.02"/> <!-- Right Post -->
      </geometry>
      <material name="cyan"/>
      <origin xyz="-0.15 -0.5 0.35" rpy="0 0 0"/>
    </visual>

    <!-- Collision (Simplified) -->
    <collision>
      <geometry>
        <box size="0.8 1.16 0.3"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
    </collision>
  </link>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!--                  WHEELS                        -->
  <!-- ============================================== -->
  <!-- Dimensions: Radius 0.15m, Width 0.1m -->

  <!-- REAR LEFT WHEEL -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.15"/>
      </geometry>
      <material name="flat_black"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
    <!-- Rim Detail -->
    <visual>
      <geometry>
        <cylinder length="0.105" radius="0.08"/>
      </geometry>
      <material name="light_grey"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.3 0.58 0.15" rpy="0 0 0"/> <!-- Wheelbase 0.6m, Track 1.16m -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR RIGHT WHEEL -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.15"/>
      </geometry>
      <material name="flat_black"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
    <!-- Rim Detail -->
    <visual>
      <geometry>
        <cylinder length="0.105" radius="0.08"/>
      </geometry>
      <material name="light_grey"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.3 -0.58 0.15" rpy="0 0 0"/> <!-- Wheelbase 0.6m, Track 1.16m -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT LEFT STEERING -->
  <link name="front_left_steering_link">
    <visual>
       <geometry>
         <cylinder length="0.05" radius="0.05"/>
       </geometry>
       <material name="light_grey"/>
    </visual>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="0.3 0.58 0.15" rpy="0 0 0"/> <!-- Wheelbase 0.6m, Track 1.16m -->
    <axis xyz="0 0 1"/>
    <limit lower="-0.1745" upper="0.1745" effort="100" velocity="1.0"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.15"/>
      </geometry>
      <material name="flat_black"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
    <!-- Rim Detail -->
    <visual>
      <geometry>
        <cylinder length="0.105" radius="0.08"/>
      </geometry>
      <material name="light_grey"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT STEERING -->
  <link name="front_right_steering_link">
    <visual>
       <geometry>
         <cylinder length="0.05" radius="0.05"/>
       </geometry>
       <material name="light_grey"/>
    </visual>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="0.3 -0.58 0.15" rpy="0 0 0"/> <!-- Wheelbase 0.6m, Track 1.16m -->
    <axis xyz="0 0 1"/>
    <limit lower="-0.1745" upper="0.1745" effort="100" velocity="1.0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.15"/>
      </geometry>
      <material name="flat_black"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
    <!-- Rim Detail -->
    <visual>
      <geometry>
        <cylinder length="0.105" radius="0.08"/>
      </geometry>
      <material name="light_grey"/>
      <origin rpy="1.57079632679 0 0"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- Camera Link -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.15 0.05"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <!-- Lens detail -->
    <visual>
      <geometry>
         <cylinder length="0.055" radius="0.02"/>
      </geometry>
      <material name="flat_black"/>
      <origin xyz="0.02 0 0" rpy="0 1.5707 0"/>
    </visual>
  </link>

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Camera at front, level orientation -->
    <origin xyz="0.45 0 0.325" rpy="0 0 0"/>
  </joint>

  <!-- Camera Optical Frames (ROS optical convention: Z forward, X right, Y down) -->
  <!-- The -90° roll and -90° yaw converts from camera_link (X forward) to optical (Z forward) -->
  
  <link name="camera_depth_frame"/>
  <joint name="camera_to_depth" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_to_optical" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <!-- Standard optical frame rotation: -90° yaw, -90° pitch equivalent to: roll=-π/2, yaw=-π/2 -->
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_to_color" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_to_optical" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_ir_frame"/>
  <joint name="camera_to_ir" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_ir_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_ir_optical_frame"/>
  <joint name="camera_ir_to_optical" type="fixed">
    <parent link="camera_ir_frame"/>
    <child link="camera_ir_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- Camera IMU frames (gyro and accel) -->
  <link name="camera_gyro_frame"/>
  <joint name="camera_to_gyro" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_gyro_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_gyro_optical_frame"/>
  <joint name="camera_gyro_to_optical" type="fixed">
    <parent link="camera_gyro_frame"/>
    <child link="camera_gyro_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_accel_frame"/>
  <joint name="camera_to_accel" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_accel_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_accel_optical_frame"/>
  <joint name="camera_accel_to_optical" type="fixed">
    <parent link="camera_accel_frame"/>
    <child link="camera_accel_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- Note: Laser scan (/scan) is generated from camera depth via pointcloud_to_laserscan node -->
  <!-- No separate lidar hardware - camera_link is the reference frame for all perception -->

  <!-- IMU Link (GY87 module on chassis) -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="cyan"/>
    </visual>
  </link>
  
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- IMU mounted flat on chassis, near center -->
    <origin xyz="0 0 0.29" rpy="0 0 0"/>
  </joint>

</robot>
