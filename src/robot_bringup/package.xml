<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Standard bringup package for the robot system, handling hardware interfacing and state publishing.</description>
  <maintainer email="xaviereconsulate22@gmail.com">xavierai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>perception_vslam</exec_depend>
  <exec_depend>ackermann_bridge_demo</exec_depend>
  <exec_depend>sensor_fusion</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
